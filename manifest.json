{
  "manifest_version": 3,
  "name": "珂拉课程表 · 一键导入",
  "version": "1.2.0",
  "description": "在教务系统的课表页点一下，就把课表整理到珂拉课程表里。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://jwxt.jit.edu.cn/*",
    "https://iedu.jlu.edu.cn/*",
    "https://card.clarkhub.cn/*"
  ],
  "externally_connectable": {
    "matches": ["https://card.clarkhub.cn/*"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "导入课表到珂拉课程表"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jwxt.jit.edu.cn/*",
        "https://iedu.jlu.edu.cn/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://card.clarkhub.cn/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
